{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "incremental": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": ".",
    // "@/*" -> project root. Lets every file import via "@/components/Foo",
    // "@/data/mockTransactions" etc. regardless of how deeply nested the importing
    // file is, instead of counting "../../.." segments — this alias survived the
    // pages/ -> app/ move unchanged, since it's root-relative, not relative to the
    // old pages/ directory structure.
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ],
  // Override just for `ts-node` (used to run prisma/seed.ts directly, outside
  // Next's own bundler). The top-level compilerOptions.module is "esnext" — required
  // for Next.js's webpack build — but ts-node executes scripts via plain Node
  // `require()`, which only understands CommonJS. Without this override, running
  // `ts-node prisma/seed.ts` would fail on the first `import` statement with
  // "Cannot use import statement outside a module".
  "ts-node": {
    "compilerOptions": {
      "module": "commonjs"
    }
  }
}

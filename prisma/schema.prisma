// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// One-to-many: a User has many Transactions via the userId foreign key below.
// cuid(): shorter than uuid, generated client-side, not sequential/guessable.
model User {
  id            String        @id @default(cuid())
  email         String        @unique
  name          String
  passwordHash  String
  monthlyBudget Int           @default(0)
  transactions  Transaction[]
  createdAt     DateTime      @default(now())
}

model Transaction {
  id            String   @id @default(cuid())
  date          DateTime
  amount        Int
  // Plain strings, not a DB enum — keeps category changes an app-level concern, not a migration.
  type          String
  description   String
  paymentMethod String
  // userId is the FK column; `user` is the relation field Prisma hydrates on `include`.
  user          User     @relation(fields: [userId], references: [id])
  userId        String
  createdAt     DateTime @default(now())
}

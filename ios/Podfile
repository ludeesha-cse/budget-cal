# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'BudgetTrackerMobile' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Work around fmt 11.0.2 using a `consteval` FMT_STRING pattern that
    # newer Clang (Xcode 16.3+/26.x) rejects with "call to consteval
    # function ... is not a constant expression". fmt/base.h unconditionally
    # redefines FMT_USE_CONSTEVAL from compiler version checks, so a
    # command-line -D override gets clobbered; patch the header directly to
    # force the constexpr fallback path instead.
    fmt_header = File.join(installer.sandbox.pod_dir('fmt').to_s, 'include', 'fmt', 'base.h')
    if File.exist?(fmt_header)
      contents = File.read(fmt_header)
      patched = contents.sub("#if FMT_USE_CONSTEVAL\n", "#if FMT_USE_CONSTEVAL && 0\n")
      if patched != contents
        File.chmod(0644, fmt_header)
        File.write(fmt_header, patched)
      end
    end
  end
end
